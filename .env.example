# Database connection (set these in Plesk Custom Environment Variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=rkwt_crm

# Admin login (defaults to superadmin / pass1234 if not set)
ADMIN_USER=superadmin
ADMIN_PASS=pass1234

# Server port (Plesk usually sets this automatically)
PORT=3001
